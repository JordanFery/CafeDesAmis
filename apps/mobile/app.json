{
  "expo": {
    "name": "Café des Amis",
    "slug": "cafedesamis",
    "scheme": "cafedesamis",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cafedesamis.mobile"
    },
    "android": {
      "package": "com.cafedesamis.mobile"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"]
  }
}
