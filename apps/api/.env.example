# Prisma / PostgreSQL
# Sur Supabase : DATABASE_URL = connection pooling (port 6543, ?pgbouncer=true)
#                DIRECT_URL   = connexion directe (port 5432), utilisée par les migrations
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cafedesamis?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cafedesamis?schema=public"

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
